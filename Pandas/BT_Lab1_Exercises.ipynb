 "cells": [\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "# B\'e0i t\uc0\u7853 p Lab 1: TensorFlow, NumPy v\'e0 Pandas\\n",\
    "---"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "## Ph\uc0\u7847 n 1: TensorFlow (BT_Lab1_01.py)\\n",\
    "Trong ph\uc0\u7847 n n\'e0y, ch\'fang ta s\u7869  th\u7921 c h\'e0nh c\'e1c thao t\'e1c c\u417  b\u7843 n tr\'ean Tensor, c\'e1c h\'e0m kh\u7903 i t\u7841 o v\'e0 x\'e2y d\u7921 ng Model \u273 \u417 n gi\u7843 n b\u7857 ng `tf.Module`."\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "import tensorflow as tf\\n",\
    "print(\\"TensorFlow version:\\", tf.__version__)"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 1 - 3: Kh\uc0\u7903 i t\u7841 o Tensor c\u417  b\u7843 n"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "# C\'e2u 1: T\uc0\u7841 o tensor [2, 3] v\u7899 i c\'e1c ph\u7847 n t\u7917  0\\n",\
    "t1 = tf.zeros([2, 3])\\n",\
    "print(\\"C\'e2u 1:\\\\n\\", t1)\\n",\
    "\\n",\
    "# C\'e2u 2: T\uc0\u7841 o tensor to\'e0n s\u7889  0 c\'f3 c\'f9ng k\'edch th\u432 \u7899 c nh\u432  X\\n",\
    "X = tf.constant([[1, 2, 3], [4, 5, 6]])\\n",\
    "t2 = tf.zeros_like(X)\\n",\
    "print(\\"\\\\nC\'e2u 2:\\\\n\\", t2)\\n",\
    "\\n",\
    "# C\'e2u 3: T\uc0\u7841 o tensor [3, 2] v\u7899 i c\'e1c ph\u7847 n t\u7917  \u273 \u432 \u7907 c g\'e1n 5\\n",\
    "t3 = tf.fill([3, 2], 5)\\n",\
    "print(\\"\\\\nC\'e2u 3:\\\\n\\", t3)"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 4 - 7: Tensor ng\uc0\u7851 u nhi\'ean v\'e0 d\u7843 i gi\'e1 tr\u7883 "\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "# C\'e2u 4: 50 ph\uc0\u7847 n t\u7917  ch\u7861 n trong kho\u7843 ng [5, 10]\\n",\
    "t4 = tf.random.uniform(shape=[50], minval=3, maxval=6, dtype=tf.int32) * 2\\n",\
    "print(\\"C\'e2u 4:\\\\n\\", t4)\\n",\
    "\\n",\
    "# C\'e2u 5: D\uc0\u7843 i gi\'e1 tr\u7883  [10, 12, ..., 100]\\n",\
    "t5 = tf.range(10, 102, delta=2)\\n",\
    "print(\\"\\\\nC\'e2u 5:\\\\n\\", t5)\\n",\
    "\\n",\
    "# C\'e2u 6: Ph\'e2n ph\uc0\u7889 i Normal (mean=0, stddev=2)\\n",\
    "t6 = tf.random.normal([3, 2], mean=0.0, stddev=2.0)\\n",\
    "print(\\"\\\\nC\'e2u 6:\\\\n\\", t6)\\n",\
    "\\n",\
    "# C\'e2u 7: Ph\'e2n ph\uc0\u7889 i Uniform trong [0, 2]\\n",\
    "t7 = tf.random.uniform([3, 2], minval=0.0, maxval=2.0)\\n",\
    "print(\\"\\\\nC\'e2u 7:\\\\n\\", t7)"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 8 - 11: Thao t\'e1c tr\'ean Tensor (Shuffle, Crop, Condition, Transpose)"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "# C\'e2u 8: Shuffle tensor\\n",\
    "X_tensor = tf.constant([[1, 2], [3, 4], [5, 6]])\\n",\
    "t8 = tf.random.shuffle(X_tensor)\\n",\
    "print(\\"C\'e2u 8:\\\\n\\", t8)\\n",\
    "\\n",\
    "# C\'e2u 9: Random Crop\\n",\
    "t9_goc = tf.random.normal((10, 10, 3))\\n",\
    "t9_cat = tf.image.random_crop(t9_goc, size=[5, 5, 3])\\n",\
    "print(\\"\\\\nC\'e2u 9 - Shape sau khi c\uc0\u7855 t:\\", t9_cat.shape)\\n",\
    "\\n",\
    "# C\'e2u 10: Logic x+y ho\uc0\u7863 c x-y d\u7921 a tr\'ean \u273 i\u7873 u ki\u7879 n\\n",\
    "x = tf.random.uniform([5], minval=1, maxval=10, dtype=tf.int32)\\n",\
    "y = tf.random.uniform([5], minval=1, maxval=10, dtype=tf.int32)\\n",\
    "t10 = tf.where(x < y, x + y, x - y)\\n",\
    "print(\\"\\\\nC\'e2u 10 - K\uc0\u7871 t qu\u7843  logic:\\", t10.numpy())\\n",\
    "\\n",\
    "# C\'e2u 11: Nh\'e2n ma tr\uc0\u7853 n v\u7899 i m\u7863 t n\u7841  \u273 \u432 \u7901 ng ch\'e9o v\'e0 c\u7897 ng chuy\u7875 n v\u7883 \\n",\
    "x_11 = tf.random.uniform([3, 2], minval=5, maxval=11, dtype=tf.int32)\\n",\
    "y_11 = tf.random.uniform([2, 3], minval=15, maxval=21, dtype=tf.int32)\\n",\
    "mask = tf.eye(3, 2, dtype=tf.int32)\\n",\
    "x_diag = x_11 * mask\\n",\
    "y_transposed = tf.transpose(y_11)\\n",\
    "print(\\"\\\\nC\'e2u 11 - x_diag + y^T:\\\\n\\", (x_diag + y_transposed).numpy())"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 12 - 19: TensorFlow Graph v\'e0 tf.Module"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "# C\'e2u 12: \uc0\u272 \u432 a h\'e0m v\'e0o Graph\\n",\
    "@tf.function\\n",\
    "def math_operations_graph(a, b):\\n",\
    "    return a + b, a - b, a * b, a / b\\n",\
    "\\n",\
    "# C\'e2u 13-16: C\'e1c Model to\'e1n h\uc0\u7885 c\\n",\
    "class SumModel(tf.Module):\\n",\
    "    @tf.function\\n",\
    "    def __call__(self, x, y): return tf.add(x, y)\\n",\
    "\\n",\
    "class PerimeterModel(tf.Module):\\n",\
    "    @tf.function\\n",\
    "    def __call__(self, a, b): return (a + b) * 2\\n",\
    "\\n",\
    "class TriangleMidsegmentModel(tf.Module):\\n",\
    "    @tf.function\\n",\
    "    def __call__(self, AM, MB, AN, NC):\\n",\
    "        return tf.logical_and(tf.equal(AM, MB), tf.equal(AN, NC))\\n",\
    "\\n",\
    "# Test Model\\n",\
    "model_sum = SumModel()\\n",\
    "print(\\"C\'e2u 13 (T\uc0\u7893 ng):\\", model_sum(tf.constant(5), tf.constant(10)).numpy())\\n",\
    "\\n",\
    "model_peri = PerimeterModel()\\n",\
    "print(\\"C\'e2u 15 (Chu vi HCN):\\", model_peri(tf.constant(4), tf.constant(6)).numpy())"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "## Ph\uc0\u7847 n 2: NumPy v\'e0 Pandas (BT_Lab1_02.py)\\n",\
    "---"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "import numpy as np\\n",\
    "import pandas as pd"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 1 - 11: Thao t\'e1c tr\'ean NumPy Array"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "# C\'e2u 1-2: Ki\uc0\u7875 m tra ph\u7847 n t\u7917 \\n",\
    "arr1 = np.random.randint(0, 21, size=(3, 3))\\n",\
    "print(\\"T\uc0\u7845 t c\u7843  kh\'e1c 0?:\\", arr1.all())\\n",\
    "print(\\"C\'f3 \'edt nh\uc0\u7845 t 1 s\u7889  kh\'e1c 0?:\\", arr1.any())\\n",\
    "\\n",\
    "# C\'e2u 4: Gh\'e9p m\uc0\u7843 ng\\n",\
    "arr4 = np.concatenate([np.ones(10), np.zeros(10), np.full(10, 5)])\\n",\
    "print(\\"\\\\nC\'e2u 4:\\\\n\\", arr4)\\n",\
    "\\n",\
    "# C\'e2u 8: \uc0\u272 \u7893 i d\u7845 u s\u7889  trong kho\u7843 ng [9, 15]\\n",\
    "arr8 = np.random.randint(0, 21, 20)\\n",\
    "arr8[(arr8 >= 9) & (arr8 <= 15)] *= -1\\n",\
    "print(\\"\\\\nC\'e2u 8 sau khi \uc0\u273 \u7893 i d\u7845 u:\\\\n\\", arr8)\\n",\
    "\\n",\
    "# C\'e2u 10: Ma tr\uc0\u7853 n bi\'ean 1, l\'f5i 0\\n",\
    "arr10 = np.ones((10, 10))\\n",\
    "arr10[1:-1, 1:-1] = 0\\n",\
    "print(\\"\\\\nC\'e2u 10:\\\\n\\", arr10)\\n",\
    "\\n",\
    "# C\'e2u 11: \uc0\u272 \u432 \u7901 ng ch\'e9o ch\'ednh\\n",\
    "arr11 = np.diag([1, 2, 3, 4, 5])\\n",\
    "print(\\"\\\\nC\'e2u 11:\\\\n\\", arr11)"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 15 - 21: Pandas Series"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "s1 = pd.Series([2, 4, 6, 8, 10])\\n",\
    "s2 = pd.Series([1, 3, 5, 7, 10])\\n",\
    "print(\\"C\uc0\u7897 ng 2 Series:\\\\n\\", s1 + s2)\\n",\
    "\\n",\
    "# C\'e2u 19: Ph\uc0\u7847 n t\u7917  trong s1 kh\'f4ng c\'f3 trong s2\\n",\
    "sr1 = pd.Series([1, 2, 3, 4, 5])\\n",\
    "sr2 = pd.Series([2, 4, 6, 8, 10])\\n",\
    "print(\\"\\\\nC\'e2u 19 (sr1 not in sr2):\\\\n\\", sr1[~sr1.isin(sr2)])"\
   ]\
  \},\
  \{\
   "cell_type": "markdown",\
   "metadata": \{\},\
   "source": [\
    "### C\'e2u 22 - 30: Thao t\'e1c tr\'ean DataFrame (D\uc0\u7919  li\u7879 u thi c\u7917 )"\
   ]\
  \},\
  \{\
   "cell_type": "code",\
   "execution_count": null,\
   "metadata": \{\},\
   "outputs": [],\
   "source": [\
    "exam_data = \{\\n",\
    "    'name': ['Anastasia', 'Dima', 'Katherine', 'James', 'Emily', 'Michael', 'Matthew', 'Laura', 'Kevin', 'Jonas'],\\n",\
    "    'score': [12.5, 9, 16.5, np.nan, 9, 20, 14.5, np.nan, 8, 19],\\n",\
    "    'attempts': [1, 3, 2, 3, 2, 3, 1, 1, 2, 1],\\n",\
    "    'qualify': ['yes', 'no', 'yes', 'no', 'no', 'yes', 'yes', 'no', 'no', 'yes']\\n",\
    "\}\\n",\
    "labels = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']\\n",\
    "df = pd.DataFrame(exam_data, index=labels)\\n",\
    "\\n",\
    "print(\\"3 d\'f2ng \uc0\u273 \u7847 u ti\'ean:\\\\n\\", df.head(3))\\n",\
    "print(\\"\\\\nD\'f2ng c\'f3 score NaN:\\\\n\\", df[df['score'].isnull()])\\n",\
    "print(\\"\\\\nScore trong kho\uc0\u7843 ng (15, 20):\\\\n\\", df[df['score'].between(15, 20)])\\n",\
    "\\n",\
    "# C\'e2u 30: S\uc0\u7917 a gi\'e1 tr\u7883 \\n",\
    "df.loc['d', 'score'] = 19\\n",\
    "print(\\"\\\\nSau khi s\uc0\u7917 a d\'f2ng 'd':\\\\n\\", df.loc['d'])"\
   ]\
  \}\
 ],\
